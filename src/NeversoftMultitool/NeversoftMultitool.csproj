<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Multi-target: cross-platform CLI + Windows GUI -->
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>NeversoftMultitool</RootNamespace>
    <AssemblyName>NeversoftMultitool</AssemblyName>
    <Version>1.3.1</Version>
    <Platforms>x64;AnyCPU</Platforms>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Single-file and trimming options for CLI builds -->
  <PropertyGroup Condition="!$(TargetFramework.Contains('windows'))">
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <!-- Windows GUI settings -->
  <PropertyGroup Condition="$(TargetFramework.Contains('windows'))">
    <OutputType>WinExe</OutputType>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN;WINDOWS_GUI</DefineConstants>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NeversoftMultitool.Tests" />
    <InternalsVisibleTo Include="PsxAnalyzer" />
    <InternalsVisibleTo Include="ThawZoneTexAnalyzer" />
    <InternalsVisibleTo Include="ThawPs2ReplayTrace" />
  </ItemGroup>

  <!-- Embedded data files -->

  <ItemGroup>

    <EmbeddedResource Include="Core\QbKey\QbKeyNames.txt" LogicalName="QbKeyNames.txt" />

    <EmbeddedResource Include="Core\QbKey\QbKeyNames.ThawGcTextures.txt" LogicalName="QbKeyNames.ThawGcTextures.txt" />

    <EmbeddedResource Include="Core\QbKey\QbKeyNames.ThawDbg.txt" LogicalName="QbKeyNames.ThawDbg.txt" />

    <EmbeddedResource Include="Core\QbKey\QbKeyNames.ThpgDbg.txt" LogicalName="QbKeyNames.ThpgDbg.txt" />

    <EmbeddedResource Include="Core\QbKey\QbKeyNames.ThawGcPaks.txt" LogicalName="QbKeyNames.ThawGcPaks.txt" />

    <EmbeddedResource Include="Core\QbKey\QbKeyNames.CutScenes.txt" LogicalName="QbKeyNames.CutScenes.txt" />

    <EmbeddedResource Include="Core\QbKey\QbKeyNames.DiscNames.txt" LogicalName="QbKeyNames.DiscNames.txt" />

    <!-- ScriptRefs sorts last so the first-wins loader prefers the proven dictionaries -->
    <EmbeddedResource Include="Core\QbKey\QbKeyNames.ScriptRefs.txt" LogicalName="QbKeyNames.ScriptRefs.txt" />

    <!-- Inline CHECKSUM_NAME (token 0x2B) registrations harvested globally from every game's
         QB scripts (proven by re-hash) — the biggest single source, THPS3/THPS4/THUG/THUG2. -->
    <EmbeddedResource Include="Core\QbKey\QbKeyNames.QbLocalNames.txt" LogicalName="QbKeyNames.QbLocalNames.txt" />

    <!-- Spider-Man TRG trigger names: strings other TRG commands carry, matched case-CRC
         onto the same build's checksum pool (>=50x-chance cells only). -->
    <EmbeddedResource Include="Core\QbKey\QbKeyNames.TrgStrings.txt" LogicalName="QbKeyNames.TrgStrings.txt" />

    <!-- THAW texture side map: opaque build-tool checksum -> source-art name (NOT QbKeys;
         kept out of Core\QbKey so it can never be loaded as a QbKeyNames dictionary). -->
    <EmbeddedResource Include="Core\Formats\Texture\ThawTextureNames.txt" LogicalName="ThawTextureNames.txt" />

  </ItemGroup>


  <!-- Blender export helper script. Blender binaries, when distributed, live beside this folder. -->

  <ItemGroup>

    <Content Include="BlenderExporter\import_package.py" CopyToOutputDirectory="PreserveNewest" />

    <Content Include="BlenderExporter\LICENSE_NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />

  </ItemGroup>


  <!-- Shared packages -->
  <ItemGroup>
    <PackageReference Include="Pfim" Version="0.11.2" />
    <PackageReference Include="SharpGLTF.Toolkit" Version="1.0.6" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="System.CommandLine" Version="2.0.1" />
    <PackageReference Include="Spectre.Console" Version="0.55.2" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.8" />
  </ItemGroup>

  <!-- Windows GUI packages. WinUI 3 was renamed back to "WinUI" in WindowsAppSDK 2.0. -->
  <ItemGroup Condition="$(TargetFramework.Contains('windows'))">
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.251219" />
  </ItemGroup>

  <!-- Windows GUI assets -->
  <ItemGroup Condition="$(TargetFramework.Contains('windows'))">
    <Content Include="Assets\AppIcon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\mesh-viewer.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\three\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Exclude GUI code from cross-platform build -->
  <ItemGroup Condition="!$(TargetFramework.Contains('windows'))">
    <Compile Remove="App\**\*.cs" />
    <Page Remove="App\**\*.xaml" />
    <Page Remove="App.xaml" />
    <Compile Remove="App.xaml.cs" />
    <None Remove="app.manifest" />
  </ItemGroup>
</Project>
