<?xml version="1.0" encoding="utf-8"?>

<UserControl
  x:Class="NeversoftMultitool.MeshConverterTab"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:NeversoftMultitool"
  xmlns:controls="using:CommunityToolkit.WinUI.Controls">

  <Grid Padding="16"
        VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header row -->
    <Grid Grid.Row="0"
          Margin="0,0,0,8">
      <StackPanel Style="{StaticResource TabHeaderStackPanelStyle}">
        <TextBlock
          Text="Mesh Conversion"
          Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBlock
          Text="Convert mesh files to glTF (.glb) or Blender (.blend), preview in 3D, and render to PNG/GIF"
          Style="{StaticResource TabSubtitleStyle}" />
      </StackPanel>
    </Grid>

    <!-- Main content: file list | 3D viewer | options panel -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.2*" MinWidth="360" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" MinWidth="300" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="300" MinWidth="260" />
      </Grid.ColumnDefinitions>

      <controls:GridSplitter
        Grid.Column="1"
        Width="8"
        ResizeBehavior="PreviousAndNext"
        ResizeDirection="Columns" />
      <controls:GridSplitter
        Grid.Column="3"
        Width="8"
        ResizeBehavior="PreviousAndNext"
        ResizeDirection="Columns" />

      <!-- Left: file list -->
      <Grid Grid.Column="0">

        <!-- File list card -->
        <Border
          x:Name="FileListCard"
          VerticalAlignment="Stretch"
          Style="{StaticResource CardBorderStyle}"
          Visibility="Collapsed">
          <Grid VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Column headers -->
            <Grid Grid.Row="0"
                  Style="{StaticResource ColumnHeaderGridStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="100" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="File Name" FontWeight="SemiBold" Margin="8,0,0,0" />
              <TextBlock Grid.Column="1" Text="Format" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="Objects" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="3" Text="Meshes" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="4" Text="Triangles" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="5" Text="Status" FontWeight="SemiBold" />
            </Grid>

            <!-- Files ListView -->
            <ListView
              x:Name="FilesListView"
              Grid.Row="1"
              SelectionMode="Single"
              SelectionChanged="FilesListView_SelectionChanged"
              Style="{StaticResource FileListViewStyle}">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:MeshFileEntry">
                  <Grid Style="{StaticResource ListItemRowGridStyle}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="80" />
                      <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                      Grid.Column="0"
                      VerticalAlignment="Center"
                      Margin="8,0,0,0"
                      Text="{x:Bind RelativePath}"
                      TextTrimming="CharacterEllipsis"
                      ToolTipService.ToolTip="{x:Bind FilePath}" />
                    <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Text="{x:Bind FormatDisplay}" />
                    <TextBlock
                      Grid.Column="2"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Text="{x:Bind ObjectsDisplay}" />
                    <TextBlock
                      Grid.Column="3"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Text="{x:Bind MeshesDisplay}" />
                    <TextBlock
                      Grid.Column="4"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Text="{x:Bind TrianglesDisplay, Mode=OneWay}" />
                    <TextBlock
                      Grid.Column="5"
                      VerticalAlignment="Center"
                      Foreground="{x:Bind StatusColor, Mode=OneWay}"
                      Text="{x:Bind StatusDisplay, Mode=OneWay}" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Grid>
        </Border>

        <!-- Empty state when no directory selected -->
        <Border
          x:Name="EmptyStatePanel"
          VerticalAlignment="Stretch"
          Style="{StaticResource CardBorderStyle}">
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="16">
            <FontIcon FontSize="64"
                      Glyph="&#xF158;"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock
              Text="No directory selected"
              FontSize="18"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              TextAlignment="Center" />
            <TextBlock
              Text="Select a folder (scanned recursively) or a .pak.ps2 worldzone archive. Companion files (DDX, PSX, TEX, SKE) are resolved automatically."
              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
              TextAlignment="Center"
              TextWrapping="Wrap"
              MaxWidth="480" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="8">
              <Button
                Content="Browse folder..."
                Click="InputBrowse_Click"
                Style="{StaticResource AccentButtonStyle}" />
              <Button
                Content="Select archive..."
                Click="SelectArchive_Click" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Middle: 3D viewer -->
      <Grid Grid.Column="2">
        <Border Style="{StaticResource CardBorderStyle}">
          <local:ModelViewerControl x:Name="ModelViewer" />
        </Border>
      </Grid>

      <!-- Right: export + render options -->
      <Grid Grid.Column="4">
        <Border Style="{StaticResource CardBorderStyle}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="12"
                        Spacing="8">

              <!-- Export options -->
              <TextBlock Text="Export"
                         FontWeight="SemiBold" />
              <CheckBox
                x:Name="ExportGlbCheckbox"
                Content="Export GLB"
                MinWidth="0"
                IsChecked="True"
                Checked="ExportFormatCheckbox_Changed"
                Unchecked="ExportFormatCheckbox_Changed" />
              <CheckBox
                x:Name="ExportBlendCheckbox"
                Content="Export Blend"
                MinWidth="0"
                IsChecked="False"
                Checked="ExportFormatCheckbox_Changed"
                Unchecked="ExportFormatCheckbox_Changed" />

              <TextBlock Text="Worldzone"
                         FontWeight="SemiBold"
                         Margin="0,8,0,0" />
              <Grid ColumnSpacing="8" RowSpacing="8">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Time"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ComboBox x:Name="WorldzoneTimeCombo"
                          Grid.Row="0" Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          SelectedIndex="0">
                  <ComboBoxItem Content="All" Tag="all" />
                  <ComboBoxItem Content="Day" Tag="day" />
                  <ComboBoxItem Content="Night" Tag="night" />
                </ComboBox>
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Scale"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox x:Name="WorldzoneScaleText"
                         Grid.Row="1" Grid.Column="1"
                         Text="1" />
              </Grid>

              <!-- Render section -->
              <TextBlock Text="Render"
                         FontWeight="SemiBold"
                         Margin="0,8,0,0" />
              <TextBlock
                Text="Renders the previewed model with the headless rasterizer (same as the glb-render / glb-gif CLI commands)."
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                FontSize="12"
                TextWrapping="Wrap" />
              <Grid ColumnSpacing="8" RowSpacing="8">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Size"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <NumberBox x:Name="RenderSizeBox"
                           Grid.Row="0" Grid.Column="1"
                           Minimum="16"
                           Maximum="4096"
                           Value="512"
                           SpinButtonPlacementMode="Compact"
                           SmallChange="64" />
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Azimuth"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <NumberBox x:Name="RenderAzimuthBox"
                           Grid.Row="1" Grid.Column="1"
                           Minimum="-360"
                           Maximum="360"
                           Value="-90"
                           SpinButtonPlacementMode="Compact"
                           SmallChange="15" />
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Elevation"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <NumberBox x:Name="RenderElevationBox"
                           Grid.Row="2" Grid.Column="1"
                           Minimum="-90"
                           Maximum="90"
                           Value="10"
                           SpinButtonPlacementMode="Compact"
                           SmallChange="5" />
                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="GIF FPS"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <NumberBox x:Name="RenderFpsBox"
                           Grid.Row="3" Grid.Column="1"
                           Minimum="1"
                           Maximum="60"
                           Value="15"
                           SpinButtonPlacementMode="Compact"
                           SmallChange="5" />
              </Grid>
              <CheckBox
                x:Name="ObjectReviewCheckbox"
                Content="Object-review preset (5 views)"
                MinWidth="0"
                IsChecked="False" />
              <Button
                x:Name="RenderPngButton"
                Content="Render PNG..."
                HorizontalAlignment="Stretch"
                IsEnabled="False"
                Click="RenderPng_Click" />
              <Button
                x:Name="RenderGifButton"
                Content="Render GIF..."
                HorizontalAlignment="Stretch"
                IsEnabled="False"
                Click="RenderGif_Click" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>

    <!-- Progress Bar -->
    <ProgressBar
      x:Name="ConversionProgress"
      Grid.Row="2"
      Maximum="100"
      Style="{StaticResource TabProgressBarStyle}" />

    <!-- I/O Section -->
    <Grid Grid.Row="3"
          Style="{StaticResource IoSectionGridStyle}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Input directory or archive -->
      <TextBlock Grid.Row="0" Grid.Column="0"
                 Text="Input:"
                 Style="{StaticResource IoLabelStyle}" />
      <TextBox x:Name="InputPathText"
               Grid.Row="0" Grid.Column="1"
               IsReadOnly="True"
               Style="{StaticResource IoTextBoxStyle}" />
      <StackPanel Grid.Row="0" Grid.Column="2"
                  Style="{StaticResource IoButtonsPanelStyle}">
        <Button Content="Browse folder..."
                MinWidth="120"
                Click="InputBrowse_Click" />
        <Button Content="Select archive..."
                MinWidth="120"
                Click="SelectArchive_Click" />
      </StackPanel>

      <!-- Output directory -->
      <TextBlock Grid.Row="1" Grid.Column="0"
                 Text="Output:"
                 Style="{StaticResource IoLabelStyle}" />
      <TextBox x:Name="OutputPathText"
               Grid.Row="1" Grid.Column="1"
               IsReadOnly="True"
               Style="{StaticResource IoTextBoxStyle}" />
      <StackPanel Grid.Row="1" Grid.Column="2"
                  Style="{StaticResource IoButtonsPanelStyle}">
        <Button Content="Browse folder..."
                MinWidth="120"
                Click="OutputBrowse_Click" />
        <Button
          x:Name="CancelButton"
          Content="Cancel"
          MinWidth="120"
          Click="CancelButton_Click"
          Visibility="Collapsed" />
        <Button
          x:Name="ConvertButton"
          Content="Convert"
          Click="ConvertButton_Click"
          IsEnabled="False"
          MinWidth="120"
          Style="{StaticResource AccentButtonStyle}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
