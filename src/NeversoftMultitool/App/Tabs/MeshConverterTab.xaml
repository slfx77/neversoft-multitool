<?xml version="1.0" encoding="utf-8"?>

<UserControl
  x:Class="NeversoftMultitool.MeshConverterTab"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:NeversoftMultitool"
  xmlns:controls="using:CommunityToolkit.WinUI.Controls">

  <Grid Padding="16"
        VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header row -->
    <Grid Grid.Row="0"
          Margin="0,0,0,8">
      <StackPanel Style="{StaticResource TabHeaderStackPanelStyle}">
        <TextBlock
          Text="Meshes &amp; Characters"
          Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBlock
          Text="Convert meshes to glTF (.glb) or Blender (.blend), preview in 3D, browse character animations, and render to PNG/GIF"
          Style="{StaticResource TabSubtitleStyle}" />
      </StackPanel>
    </Grid>

    <!-- Main content: file list | 3D viewer | tabbed panel -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.2*" MinWidth="360" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" MinWidth="300" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="320" MinWidth="280" />
      </Grid.ColumnDefinitions>

      <controls:GridSplitter
        Grid.Column="1"
        Width="8"
        ResizeBehavior="PreviousAndNext"
        ResizeDirection="Columns" />
      <controls:GridSplitter
        Grid.Column="3"
        Width="8"
        ResizeBehavior="PreviousAndNext"
        ResizeDirection="Columns" />

      <!-- Left: file list -->
      <Grid Grid.Column="0">

        <!-- File list card -->
        <Border
          x:Name="FileListCard"
          VerticalAlignment="Stretch"
          Style="{StaticResource CardBorderStyle}"
          Visibility="Collapsed">
          <Grid VerticalAlignment="Stretch"
                local:FileTableBehavior.IsEnabled="True">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Batch-selection toolbar -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Padding="0,0,8,4"
                        Spacing="8">
              <Button Content="Select all"
                      Click="FilesSelectAll_Click" />
              <Button Content="Select none"
                      Click="FilesSelectNone_Click" />
            </StackPanel>

            <!-- Column headers -->
            <Grid Grid.Row="1"
                  Style="{StaticResource ColumnHeaderGridStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="100" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="" />
              <Button Grid.Column="1"
                      Content="File Name"
                      Margin="8,0,0,0"
                      Style="{StaticResource SortableColumnHeaderButtonStyle}"
                      local:FileTableBehavior.SortProperty="RelativePath" />
              <Button Grid.Column="2"
                      Content="Format"
                      HorizontalContentAlignment="Center"
                      Style="{StaticResource SortableColumnHeaderButtonStyle}"
                      local:FileTableBehavior.SortProperty="Format" />
              <Button Grid.Column="3"
                      Content="Objects"
                      HorizontalContentAlignment="Center"
                      Style="{StaticResource SortableColumnHeaderButtonStyle}"
                      local:FileTableBehavior.SortProperty="ObjectCount" />
              <Button Grid.Column="4"
                      Content="Meshes"
                      HorizontalContentAlignment="Center"
                      Style="{StaticResource SortableColumnHeaderButtonStyle}"
                      local:FileTableBehavior.SortProperty="MeshCount" />
              <Button Grid.Column="5"
                      Content="Triangles"
                      HorizontalContentAlignment="Center"
                      Style="{StaticResource SortableColumnHeaderButtonStyle}"
                      local:FileTableBehavior.SortProperty="TriangleCount" />
              <Button Grid.Column="6"
                      Content="Status"
                      Style="{StaticResource SortableColumnHeaderButtonStyle}"
                      local:FileTableBehavior.SortProperty="Status" />
            </Grid>

            <!-- Files ListView -->
            <ListView
              x:Name="FilesListView"
              Grid.Row="2"
              SelectionMode="Single"
              SelectionChanged="FilesListView_SelectionChanged"
              Style="{StaticResource FileListViewStyle}">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:MeshFileEntry">
                  <Grid Style="{StaticResource ListItemRowGridStyle}"
                        local:FileTableBehavior.IsRow="True">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="32" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="80" />
                      <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                      Grid.Column="0"
                      VerticalAlignment="Center"
                      Margin="6,0,0,0"
                      MinWidth="24"
                      IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                      Click="FileCheckbox_Click" />
                    <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Margin="8,0,0,0"
                      Text="{x:Bind RelativePath}"
                      TextTrimming="CharacterEllipsis"
                      ToolTipService.ToolTip="{x:Bind FilePath}" />
                    <TextBlock
                      Grid.Column="2"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Text="{x:Bind FormatDisplay}" />
                    <TextBlock
                      Grid.Column="3"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Text="{x:Bind ObjectsDisplay}" />
                    <TextBlock
                      Grid.Column="4"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Text="{x:Bind MeshesDisplay}" />
                    <TextBlock
                      Grid.Column="5"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Text="{x:Bind TrianglesDisplay, Mode=OneWay}" />
                    <TextBlock
                      Grid.Column="6"
                      VerticalAlignment="Center"
                      Foreground="{x:Bind StatusColor, Mode=OneWay}"
                      Text="{x:Bind StatusDisplay, Mode=OneWay}" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Grid>
        </Border>

        <!-- Empty state when no directory selected -->
        <Border
          x:Name="EmptyStatePanel"
          VerticalAlignment="Stretch"
          Style="{StaticResource CardBorderStyle}">
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="16">
            <FontIcon FontSize="64"
                      Glyph="&#xF158;"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock
              Text="No directory selected"
              FontSize="18"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              TextAlignment="Center" />
            <TextBlock
              Text="Select a folder (scanned recursively) or a game archive. Companion files (DDX, PSX, TEX, SKE) are resolved automatically; skinned characters get an Animations panel."
              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
              TextAlignment="Center"
              TextWrapping="Wrap"
              MaxWidth="480" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="8">
              <Button
                Content="Browse folder..."
                Click="InputBrowse_Click"
                Style="{StaticResource AccentButtonStyle}" />
              <Button
                Content="Select archive..."
                Click="SelectArchive_Click" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Middle: 3D viewer -->
      <Grid Grid.Column="2">
        <Border Style="{StaticResource CardBorderStyle}">
          <local:ModelViewerControl x:Name="ModelViewer" />
        </Border>
      </Grid>

      <!-- Right: Animations / Settings / Export panes.
           The SelectorBar's initial selection is set in the constructor —
           a XAML default would fire SelectionChanged mid-InitializeComponent. -->
      <Grid Grid.Column="4">
        <Border Style="{StaticResource CardBorderStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <SelectorBar x:Name="PanelSelector"
                         Grid.Row="0"
                         Margin="4,0,4,4"
                         SelectionChanged="PanelSelector_SelectionChanged">
              <SelectorBarItem x:Name="AnimationsPanelItem" Text="Animations" />
              <SelectorBarItem x:Name="SettingsPanelItem" Text="Settings" />
              <SelectorBarItem x:Name="ExportPanelItem" Text="Export" />
            </SelectorBar>

            <Grid Grid.Row="1">

              <!-- Animations pane -->
              <Grid x:Name="AnimationsPane"
                    local:FileTableBehavior.IsEnabled="True"
                    Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Panel header (left-aligned with the column header below) -->
                <StackPanel Grid.Row="0"
                            Padding="8,4,8,8"
                            Spacing="6">
                  <TextBlock
                    x:Name="AnimDiscoveryStatusText"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Text="Select a skinned character to scan for animations." />
                  <Grid ColumnSpacing="4"
                        RowSpacing="4">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                      x:Name="AddAnimFolderButton"
                      Grid.Row="0"
                      Grid.Column="0"
                      Content="Add folder..."
                      Click="AddAnimFolder_Click"
                      HorizontalAlignment="Stretch"
                      IsEnabled="False" />
                    <Button
                      x:Name="AddAnimArchiveButton"
                      Grid.Row="0"
                      Grid.Column="1"
                      Content="Add archive..."
                      Click="AddAnimArchive_Click"
                      HorizontalAlignment="Stretch"
                      IsEnabled="False" />
                    <Button Grid.Row="1"
                            Grid.Column="0"
                            Content="Select all"
                            HorizontalAlignment="Stretch"
                            Click="AnimsSelectAll_Click" />
                    <Button Grid.Row="1"
                            Grid.Column="1"
                            Content="Select none"
                            HorizontalAlignment="Stretch"
                            Click="AnimsSelectNone_Click" />
                  </Grid>
                  <CheckBox
                    x:Name="ShowAllAnimsCheckBox"
                    Content="Show all"
                    MinWidth="0"
                    IsChecked="False"
                    ToolTipService.ToolTip="Also list animations whose bone count doesn't match this skeleton"
                    Click="ShowAllAnims_Click" />
                </StackPanel>

                <!-- List header -->
                <Grid Grid.Row="1"
                      Style="{StaticResource ColumnHeaderGridStyle}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="" />
                  <Button Grid.Column="1"
                          Content="Animation"
                          Margin="8,0,0,0"
                          Style="{StaticResource SortableColumnHeaderButtonStyle}"
                          local:FileTableBehavior.SortProperty="DisplayName" />
                  <Button Grid.Column="2"
                          Content="Length"
                          Margin="0,0,8,0"
                          HorizontalContentAlignment="Right"
                          Style="{StaticResource SortableColumnHeaderButtonStyle}"
                          local:FileTableBehavior.SortProperty="Probe.DurationSec" />
                </Grid>

                <!-- Animation list -->
                <ListView
                  x:Name="AnimationListView"
                  Grid.Row="2"
                  SelectionMode="Single"
                  SelectionChanged="AnimationListView_SelectionChanged"
                  Style="{StaticResource FileListViewStyle}">
                  <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:AnimationListEntry">
                      <Grid Style="{StaticResource ListItemRowGridStyle}"
                            local:FileTableBehavior.IsRow="True"
                            ToolTipService.ToolTip="{x:Bind MismatchTooltip}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="32" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                          Grid.Column="0"
                          VerticalAlignment="Center"
                          Margin="6,0,0,0"
                          MinWidth="24"
                          IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                          IsEnabled="{x:Bind MatchesSkeleton}" />
                        <TextBlock
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Margin="8,0,0,0"
                          Text="{x:Bind DisplayName}"
                          Foreground="{x:Bind RowForeground}"
                          TextTrimming="CharacterEllipsis" />
                        <TextBlock
                          Grid.Column="2"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right"
                          Margin="0,0,8,0"
                          Text="{x:Bind DurationDisplay}"
                          Foreground="{x:Bind RowForeground}" />
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>

                <!-- Animated export actions -->
                <StackPanel Grid.Row="3"
                            Padding="8,8"
                            Spacing="4">
                  <Button
                    x:Name="ConvertBlendButton"
                    Content="Export animated Blend..."
                    HorizontalAlignment="Stretch"
                    IsEnabled="False"
                    Click="ConvertBlend_Click" />
                  <Button
                    x:Name="ConvertGlbButton"
                    Content="Export animated GLB..."
                    HorizontalAlignment="Stretch"
                    IsEnabled="False"
                    Click="ConvertGlb_Click"
                    Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
              </Grid>

              <!-- Settings pane -->
              <ScrollViewer x:Name="SettingsPane"
                            Visibility="Collapsed"
                            VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="8,4,8,8"
                            Spacing="8">
                  <TextBlock Text="Viewport"
                             FontWeight="SemiBold" />
                  <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Lighting"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="WorldzoneTimeCombo"
                              Grid.Row="0" Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              SelectedIndex="0"
                              SelectionChanged="WorldzoneTimeCombo_SelectionChanged">
                      <ComboBoxItem Content="Day" Tag="day" />
                      <ComboBoxItem Content="Night" Tag="night" />
                    </ComboBox>
                  </Grid>

                </StackPanel>
              </ScrollViewer>

              <!-- Export pane -->
              <ScrollViewer x:Name="ExportPane"
                            VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="8,4,8,8"
                            Spacing="8">
                  <TextBlock Text="Convert"
                             FontWeight="SemiBold" />
                  <TextBlock Text="Worldzone"
                             FontWeight="SemiBold"
                             Margin="0,4,0,0" />
                  <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Lighting"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ToggleSwitch x:Name="ExportWorldzoneNightToggle"
                                  Grid.Row="0" Grid.Column="1"
                                  OffContent="Day"
                                  OnContent="Night"
                                  IsOn="False" />
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Scale"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBox x:Name="WorldzoneScaleText"
                             Grid.Row="1" Grid.Column="1"
                             Text="1" />
                  </Grid>
                  <CheckBox
                    x:Name="ExportGlbCheckbox"
                    Content="Export GLB"
                    MinWidth="0"
                    IsChecked="True"
                    Checked="ExportFormatCheckbox_Changed"
                    Unchecked="ExportFormatCheckbox_Changed" />
                  <CheckBox
                    x:Name="ExportBlendCheckbox"
                    Content="Export Blend"
                    MinWidth="0"
                    IsChecked="False"
                    Checked="ExportFormatCheckbox_Changed"
                    Unchecked="ExportFormatCheckbox_Changed" />
                  <Button
                    x:Name="ConvertButton"
                    Content="Convert checked files"
                    HorizontalAlignment="Stretch"
                    Click="ConvertButton_Click"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" />
                  <Button
                    x:Name="CancelButton"
                    Content="Cancel"
                    HorizontalAlignment="Stretch"
                    Click="CancelButton_Click"
                    Visibility="Collapsed" />

                  <TextBlock Text="Render"
                             FontWeight="SemiBold"
                             Margin="0,8,0,0" />
                  <TextBlock
                    Text="Headless rasterizer — not the interactive viewport camera. One checked file renders the loaded preview; several checked files convert and render each in turn."
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    FontSize="12"
                    TextWrapping="Wrap" />
                  <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Size"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <NumberBox x:Name="RenderSizeBox"
                               Grid.Row="0" Grid.Column="1"
                               Minimum="16"
                               Maximum="4096"
                               Value="512"
                               SpinButtonPlacementMode="Compact"
                               SmallChange="64" />
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Azimuth"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <NumberBox x:Name="RenderAzimuthBox"
                               Grid.Row="1" Grid.Column="1"
                               Minimum="-360"
                               Maximum="360"
                               Value="-90"
                               SpinButtonPlacementMode="Compact"
                               SmallChange="15" />
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="Elevation"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <NumberBox x:Name="RenderElevationBox"
                               Grid.Row="2" Grid.Column="1"
                               Minimum="-90"
                               Maximum="90"
                               Value="10"
                               SpinButtonPlacementMode="Compact"
                               SmallChange="5" />
                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Text="GIF FPS"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <NumberBox x:Name="RenderFpsBox"
                               Grid.Row="3" Grid.Column="1"
                               Minimum="1"
                               Maximum="60"
                               Value="15"
                               SpinButtonPlacementMode="Compact"
                               SmallChange="5" />
                  </Grid>
                  <CheckBox
                    x:Name="ObjectReviewCheckbox"
                    Content="Object-review preset (5 views)"
                    MinWidth="0"
                    IsChecked="False" />
                  <Button
                    x:Name="RenderPngButton"
                    Content="Render PNG..."
                    HorizontalAlignment="Stretch"
                    IsEnabled="False"
                    Click="RenderPng_Click" />
                  <Button
                    x:Name="RenderGifButton"
                    Content="Render GIF..."
                    HorizontalAlignment="Stretch"
                    IsEnabled="False"
                    Click="RenderGif_Click" />
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Progress Bar -->
    <ProgressBar
      x:Name="ConversionProgress"
      Grid.Row="2"
      Maximum="100"
      Style="{StaticResource TabProgressBarStyle}" />

    <!-- I/O Section -->
    <Grid Grid.Row="3"
          Style="{StaticResource IoSectionGridStyle}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Input directory or archive -->
      <TextBlock Grid.Row="0" Grid.Column="0"
                 Text="Input:"
                 Style="{StaticResource IoLabelStyle}" />
      <TextBox x:Name="InputPathText"
               Grid.Row="0" Grid.Column="1"
               IsReadOnly="True"
               Style="{StaticResource IoTextBoxStyle}" />
      <StackPanel Grid.Row="0" Grid.Column="2"
                  Style="{StaticResource IoButtonsPanelStyle}">
        <Button Content="Browse folder..."
                MinWidth="120"
                Click="InputBrowse_Click" />
        <Button Content="Select archive..."
                MinWidth="120"
                Click="SelectArchive_Click" />
      </StackPanel>

      <!-- Output directory -->
      <TextBlock Grid.Row="1" Grid.Column="0"
                 Text="Output:"
                 Style="{StaticResource IoLabelStyle}" />
      <TextBox x:Name="OutputPathText"
               Grid.Row="1" Grid.Column="1"
               IsReadOnly="True"
               Style="{StaticResource IoTextBoxStyle}" />
      <StackPanel Grid.Row="1" Grid.Column="2"
                  Style="{StaticResource IoButtonsPanelStyle}">
        <Button Content="Browse folder..."
                MinWidth="120"
                Click="OutputBrowse_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
