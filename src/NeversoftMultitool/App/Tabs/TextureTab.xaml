<?xml version="1.0" encoding="utf-8"?>

<UserControl
  x:Class="NeversoftMultitool.TextureTab"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:NeversoftMultitool"
  xmlns:controls="using:CommunityToolkit.WinUI.Controls">

  <UserControl.Resources>
    <local:ExpandableListTemplateSelector x:Key="ListTemplateSelector">

      <!-- Parent row: PSX file -->
      <local:ExpandableListTemplateSelector.ParentTemplate>
        <DataTemplate x:DataType="local:PsxFileEntry">
          <Grid Style="{StaticResource ListItemRowGridStyle}"
                local:FileTableBehavior.IsRow="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="56" MinWidth="56" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="0.7*" />
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <Button
              Grid.Column="0"
              Padding="0"
              MinWidth="0"
              MinHeight="0"
              Width="24" Height="24"
              Background="Transparent"
              BorderThickness="0"
              HorizontalAlignment="Left"
              Click="ExpandCollapse_Click"
              Tag="{x:Bind}"
              Visibility="{x:Bind ExpanderVisibility, Mode=OneWay}"
              VerticalAlignment="Center">
              <FontIcon
                FontSize="10"
                Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" />
            </Button>
            <TextBlock
              Grid.Column="1"
              VerticalAlignment="Center"
              Text="{x:Bind FileName}"
              TextTrimming="CharacterEllipsis"
              ToolTipService.ToolTip="{x:Bind RelativePath}" />
            <TextBlock
              Grid.Column="2"
              VerticalAlignment="Center"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Text="{x:Bind FolderDisplay}"
              TextTrimming="CharacterEllipsis"
              ToolTipService.ToolTip="{x:Bind FolderDisplay}" />
            <TextBlock
              Grid.Column="3"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Text="{x:Bind TextureCountDisplay, Mode=OneWay}" />
            <TextBlock
              Grid.Column="4"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Text="{x:Bind ExtractedCountDisplay, Mode=OneWay}" />
            <TextBlock
              Grid.Column="5"
              VerticalAlignment="Center"
              Foreground="{x:Bind StatusColor, Mode=OneWay}"
              Text="{x:Bind StatusDisplay, Mode=OneWay}" />
          </Grid>
        </DataTemplate>
      </local:ExpandableListTemplateSelector.ParentTemplate>

      <!-- Child row: individual texture -->
      <local:ExpandableListTemplateSelector.ChildTemplate>
        <DataTemplate x:DataType="local:PsxTextureEntry">
          <Grid Style="{StaticResource ListItemRowGridStyle}"
                local:FileTableBehavior.IsRow="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="56" MinWidth="56" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="0.7*" />
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Grid.Column="0"
              Grid.ColumnSpan="3"
              Margin="28,0,0,0"
              VerticalAlignment="Center"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Text="{x:Bind NameDisplay}"
              TextTrimming="CharacterEllipsis"
              ToolTipService.ToolTip="{x:Bind HashDisplay}" />
            <TextBlock
              Grid.Column="3"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Text="{x:Bind DimensionsDisplay}" />
            <TextBlock
              Grid.Column="4"
              Grid.ColumnSpan="2"
              VerticalAlignment="Center"
              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
              Text="{x:Bind PaletteType}" />
          </Grid>
        </DataTemplate>
      </local:ExpandableListTemplateSelector.ChildTemplate>

    </local:ExpandableListTemplateSelector>
  </UserControl.Resources>

  <Grid Padding="16"
        VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header row -->
    <Grid Grid.Row="0"
          Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Style="{StaticResource TabHeaderStackPanelStyle}">
        <TextBlock
          Text="Texture Extraction"
          Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBlock
          Text="Extract textures from Neversoft game files"
          Style="{StaticResource TabSubtitleStyle}" />
      </StackPanel>
    </Grid>

    <!-- Main content: file list + preview -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" MinWidth="200" />
        <ColumnDefinition x:Name="SplitterColumn" Width="8" />
        <ColumnDefinition x:Name="PreviewColumn" Width="2*" MinWidth="220" />
      </Grid.ColumnDefinitions>

      <controls:GridSplitter
        x:Name="PreviewSplitter"
        Grid.Column="1"
        Width="8"
        ResizeBehavior="PreviousAndNext"
        ResizeDirection="Columns" />

      <!-- File list card -->
      <Border
        x:Name="FileListCard"
        Grid.Column="0"
        VerticalAlignment="Stretch"
        Style="{StaticResource CardBorderStyle}"
        Visibility="Collapsed">
        <Grid VerticalAlignment="Stretch"
              local:FileTableBehavior.IsEnabled="True">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Column headers -->
          <Grid Grid.Row="0"
                Style="{StaticResource ColumnHeaderGridStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="56" MinWidth="56" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="0.7*" />
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
              <Button
                Padding="0"
                MinWidth="0"
                MinHeight="0"
                Width="24" Height="24"
                Background="Transparent"
                BorderThickness="0"
                Click="ExpandAll_Click"
                ToolTipService.ToolTip="Expand all">
                <FontIcon FontSize="10" Glyph="&#xE70D;" />
              </Button>
              <Button
                Padding="0"
                MinWidth="0"
                MinHeight="0"
                Width="24" Height="24"
                Background="Transparent"
                BorderThickness="0"
                Click="CollapseAll_Click"
                ToolTipService.ToolTip="Collapse all">
                <FontIcon FontSize="10" Glyph="&#xE70E;" />
              </Button>
            </StackPanel>
            <Button
              Grid.Column="1"
              Content="File Name"
              Style="{StaticResource SortableColumnHeaderButtonStyle}"
              local:FileTableBehavior.SortProperty="FileName" />
            <Button
              Grid.Column="2"
              Content="Folder"
              Style="{StaticResource SortableColumnHeaderButtonStyle}"
              local:FileTableBehavior.SortProperty="FolderDisplay" />
            <Button
              Grid.Column="3"
              Content="Textures"
              HorizontalContentAlignment="Center"
              Style="{StaticResource SortableColumnHeaderButtonStyle}"
              local:FileTableBehavior.SortProperty="TextureCount" />
            <Button
              Grid.Column="4"
              Content="Extracted"
              HorizontalContentAlignment="Center"
              Style="{StaticResource SortableColumnHeaderButtonStyle}"
              local:FileTableBehavior.SortProperty="ExtractedCount" />
            <Button
              Grid.Column="5"
              Content="Status"
              Style="{StaticResource SortableColumnHeaderButtonStyle}"
              local:FileTableBehavior.SortProperty="Status" />
          </Grid>

          <!-- Files ListView -->
          <ListView
            x:Name="FilesListView"
            Grid.Row="1"
            SelectionMode="Single"
            Style="{StaticResource FileListViewStyle}"
            SelectionChanged="FilesListView_SelectionChanged"
            ItemTemplateSelector="{StaticResource ListTemplateSelector}" />
        </Grid>
      </Border>

      <!-- Scan-in-progress indicator (overlays whichever card is visible) -->
      <ProgressRing
        x:Name="ScanProgressRing"
        Grid.Column="0"
        Width="48" Height="48"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        IsActive="False"
        Visibility="Collapsed"
        Canvas.ZIndex="10" />

      <!-- Empty state when no directory selected -->
      <Border
        x:Name="EmptyStatePanel"
        Grid.Column="0"
        VerticalAlignment="Stretch"
        Style="{StaticResource CardBorderStyle}">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
          <FontIcon FontSize="64"
                    Glyph="&#xEB9F;"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock
            Text="No directory selected"
            FontSize="18"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextAlignment="Center" />
          <TextBlock
            Text="Select a folder of texture files or a game archive (WAD/PRE/PKR/PAK/...)"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            TextAlignment="Center"
            TextWrapping="Wrap"
            MaxWidth="440" />
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      Spacing="8">
            <Button
              Content="Browse folder..."
              Click="InputBrowse_Click"
              Style="{StaticResource AccentButtonStyle}" />
            <Button
              Content="Select archive..."
              Click="SelectArchive_Click" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Preview panel -->
      <Border
        x:Name="PreviewPanel"
        Grid.Column="2"
        VerticalAlignment="Stretch"
        Style="{StaticResource CardBorderStyle}">
        <Grid Margin="4" RowSpacing="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <local:ImagePreviewControl x:Name="TexturePreview"
                                     Grid.Row="0" />
          <TextBlock x:Name="PreviewInfoText"
                     Grid.Row="1"
                     HorizontalAlignment="Center"
                     Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                     FontSize="11"
                     TextWrapping="Wrap"
                     TextAlignment="Center" />
        </Grid>
      </Border>
    </Grid>

    <!-- I/O Section -->
    <Grid Grid.Row="3"
          Style="{StaticResource IoSectionGridStyle}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0"
                 Text="Input:"
                 Style="{StaticResource IoLabelStyle}" />
      <TextBox x:Name="InputPathText"
               Grid.Row="0" Grid.Column="1"
               IsReadOnly="True"
               Style="{StaticResource IoTextBoxStyle}" />
      <StackPanel Grid.Row="0" Grid.Column="2"
                  Style="{StaticResource IoButtonsPanelStyle}">
        <Button Content="Browse folder..."
                MinWidth="120"
                Click="InputBrowse_Click" />
        <Button Content="Select archive..."
                MinWidth="120"
                Click="SelectArchive_Click" />
      </StackPanel>

      <TextBlock Grid.Row="1" Grid.Column="0"
                 Text="Output:"
                 Style="{StaticResource IoLabelStyle}" />
      <TextBox x:Name="OutputPathText"
               Grid.Row="1" Grid.Column="1"
               IsReadOnly="True"
               Style="{StaticResource IoTextBoxStyle}" />
      <StackPanel Grid.Row="1" Grid.Column="2"
                  Style="{StaticResource IoButtonsPanelStyle}">
        <Button Content="Browse folder..."
                MinWidth="120"
                Click="OutputBrowse_Click" />
        <Button
          x:Name="CancelButton"
          Content="Cancel"
          MinWidth="120"
          Click="CancelButton_Click"
          Visibility="Collapsed" />
        <Button
          x:Name="ExtractButton"
          Content="Extract"
          Click="ExtractButton_Click"
          IsEnabled="False"
          MinWidth="120"
          Style="{StaticResource AccentButtonStyle}" />
      </StackPanel>

      <TextBlock Grid.Row="2" Grid.Column="0"
                 Text="Options:"
                 Style="{StaticResource IoLabelStyle}" />
      <StackPanel Grid.Row="2" Grid.Column="1"
                  Orientation="Horizontal" Spacing="16">
        <CheckBox
          x:Name="CreateSubDirsCheckbox"
          Content="Create Subdirectories"
          MinWidth="0"
          IsChecked="False" />
        <CheckBox
          x:Name="WriteDdsCheckbox"
          Content="Include DDS"
          MinWidth="0"
          IsChecked="False" />
        <CheckBox
          x:Name="WriteMipAtlasCheckbox"
          Content="Include Mip Atlas"
          MinWidth="0"
          IsChecked="False" />
      </StackPanel>
    </Grid>

    <!-- Progress Bar -->
    <ProgressBar
      x:Name="ExtractionProgress"
      Grid.Row="2"
      Maximum="100"
      Style="{StaticResource TabProgressBarStyle}" />
  </Grid>
</UserControl>
