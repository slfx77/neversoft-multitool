<?xml version="1.0" encoding="utf-8"?>

<UserControl
  x:Class="NeversoftMultitool.ArchiveExtractorTab"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:NeversoftMultitool">

  <Grid Padding="16"
        VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header row -->
    <Grid Grid.Row="0"
          Margin="0,0,0,8">
      <StackPanel Style="{StaticResource TabHeaderStackPanelStyle}">
        <TextBlock
          Text="Archive Extraction"
          Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBlock
          Text="Extract files from WAD, PKR, PRE, DDX, and BON archives, or disc images (ISO, BIN+CUE, IMG+CCD, GDI)"
          Style="{StaticResource TabSubtitleStyle}" />
      </StackPanel>
    </Grid>

    <!-- Archive Info Card -->
    <Border
      x:Name="ArchiveInfoCard"
      Grid.Row="1"
      Margin="0,0,0,8"
      Style="{StaticResource CardBorderStyle}"
      Visibility="Collapsed">
      <Grid Padding="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0"
                    Orientation="Vertical"
                    Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Archive:" FontWeight="SemiBold" />
            <TextBlock x:Name="ArchiveNameText" Text="-" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Type:" FontWeight="SemiBold" />
            <TextBlock x:Name="ArchiveTypeText" Text="-" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Vertical"
                    Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Files:" FontWeight="SemiBold" />
            <TextBlock x:Name="ArchiveFileCountText" Text="-" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- File list card -->
    <Border
      x:Name="FileListCard"
      Grid.Row="2"
      VerticalAlignment="Stretch"
      Style="{StaticResource CardBorderStyle}"
      Visibility="Collapsed">
      <Grid VerticalAlignment="Stretch"
            local:FileTableBehavior.IsEnabled="True">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Column headers -->
        <Grid Grid.Row="0"
              Style="{StaticResource ColumnHeaderGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="0.7*" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="90" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0"
                  Content="File Name"
                  Style="{StaticResource SortableColumnHeaderButtonStyle}"
                  local:FileTableBehavior.SortProperty="FileName" />
          <Button Grid.Column="1"
                  Content="Folder"
                  Style="{StaticResource SortableColumnHeaderButtonStyle}"
                  local:FileTableBehavior.SortProperty="Folder" />
          <Button Grid.Column="2"
                  Content="Size"
                  Margin="0,0,16,0"
                  HorizontalContentAlignment="Right"
                  Style="{StaticResource SortableColumnHeaderButtonStyle}"
                  local:FileTableBehavior.SortProperty="Size" />
          <Button Grid.Column="3"
                  Content="Status"
                  Style="{StaticResource SortableColumnHeaderButtonStyle}"
                  local:FileTableBehavior.SortProperty="Status" />
        </Grid>

        <!-- Files ListView -->
        <ListView
          x:Name="FilesListView"
          Grid.Row="1"
          Style="{StaticResource FileListViewStyle}">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:ArchiveFileEntry">
              <Grid Style="{StaticResource ListItemRowGridStyle}"
                    local:FileTableBehavior.IsRow="True">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="0.7*" />
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Text="{x:Bind FileName}"
                  TextTrimming="CharacterEllipsis"
                  ToolTipService.ToolTip="{x:Bind FileName}" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Text="{x:Bind Folder}"
                  TextTrimming="CharacterEllipsis"
                  ToolTipService.ToolTip="{x:Bind Folder}" />
                <TextBlock
                  Grid.Column="2"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Right"
                  Margin="0,0,16,0"
                  Text="{x:Bind SizeDisplay}" />
                <TextBlock
                  Grid.Column="3"
                  VerticalAlignment="Center"
                  Foreground="{x:Bind StatusColor, Mode=OneWay}"
                  Text="{x:Bind StatusDisplay, Mode=OneWay}" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Border>

    <!-- Empty state -->
    <Border
      x:Name="EmptyStatePanel"
      Grid.Row="2"
      VerticalAlignment="Stretch"
      Style="{StaticResource CardBorderStyle}">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="16">
        <FontIcon FontSize="64"
                  Glyph="&#xE7B8;"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock
          Text="No archive loaded"
          FontSize="18"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          TextAlignment="Center" />
        <TextBlock
          Text="Open a WAD, PKR, PRE, DDX, or BON archive to view its contents"
          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
          TextAlignment="Center" />
        <Button
          Content="Browse..."
          HorizontalAlignment="Center"
          Click="OpenArchiveButton_Click"
          Style="{StaticResource AccentButtonStyle}" />
      </StackPanel>
    </Border>

    <!-- I/O Section -->
    <Grid Grid.Row="4"
          Style="{StaticResource IoSectionGridStyle}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0"
                 Text="Input:"
                 Style="{StaticResource IoLabelStyle}" />
      <TextBox x:Name="InputPathText"
               Grid.Row="0" Grid.Column="1"
               IsReadOnly="True"
               Style="{StaticResource IoTextBoxStyle}" />
      <StackPanel Grid.Row="0" Grid.Column="2"
                  Style="{StaticResource IoButtonsPanelStyle}">
        <Button Content="Select archive..."
                MinWidth="120"
                Click="OpenArchiveButton_Click" />
      </StackPanel>

      <TextBlock Grid.Row="1" Grid.Column="0"
                 Text="Output:"
                 Style="{StaticResource IoLabelStyle}" />
      <TextBox x:Name="OutputPathText"
               Grid.Row="1" Grid.Column="1"
               IsReadOnly="True"
               Style="{StaticResource IoTextBoxStyle}" />
      <StackPanel Grid.Row="1" Grid.Column="2"
                  Style="{StaticResource IoButtonsPanelStyle}">
        <Button Content="Browse folder..."
                MinWidth="120"
                Click="OutputBrowse_Click" />
        <!-- Cancel occupies Extract's slot while an extraction runs. -->
        <Button
          x:Name="CancelButton"
          Content="Cancel"
          MinWidth="120"
          Click="CancelButton_Click"
          Visibility="Collapsed" />
        <Button
          x:Name="ExtractButton"
          Content="Extract"
          MinWidth="120"
          Click="ExtractButton_Click"
          IsEnabled="False"
          Style="{StaticResource AccentButtonStyle}" />
      </StackPanel>
    </Grid>

    <!-- Progress Bar -->
    <ProgressBar
      x:Name="ExtractionProgress"
      Grid.Row="3"
      Maximum="100"
      Style="{StaticResource TabProgressBarStyle}" />
  </Grid>
</UserControl>
