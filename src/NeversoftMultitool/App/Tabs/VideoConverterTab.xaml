<?xml version="1.0" encoding="utf-8"?>

<UserControl
  x:Class="NeversoftMultitool.VideoConverterTab"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:NeversoftMultitool"
  xmlns:controls="using:CommunityToolkit.WinUI.Controls">

  <UserControl.Resources>
    <local:TimeSliderValueConverter x:Key="PlaybackTooltipConverter" />
  </UserControl.Resources>

  <Grid Padding="16"
        VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header row -->
    <Grid Grid.Row="0"
          Margin="0,0,0,8">
      <StackPanel Style="{StaticResource TabHeaderStackPanelStyle}">
        <TextBlock
          Text="Video Conversion"
          Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBlock
          Text="Convert SFD, PSS, BIK, VID1 (.vid), and STR (PS1 MDEC) video files to MP4"
          Style="{StaticResource TabSubtitleStyle}" />
      </StackPanel>
    </Grid>

    <!-- Main content: file list + preview -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" MinWidth="200" />
        <ColumnDefinition x:Name="SplitterColumn" Width="8" />
        <ColumnDefinition x:Name="PreviewColumn" Width="2*" MinWidth="260" />
      </Grid.ColumnDefinitions>

      <controls:GridSplitter
        x:Name="PreviewSplitter"
        Grid.Column="1"
        Width="8"
        ResizeBehavior="PreviousAndNext"
        ResizeDirection="Columns" />

      <!-- File list card -->
      <Border
        x:Name="FileListCard"
        Grid.Column="0"
        VerticalAlignment="Stretch"
        Style="{StaticResource CardBorderStyle}"
        Visibility="Collapsed">
        <Grid VerticalAlignment="Stretch"
              local:FileTableBehavior.IsEnabled="True">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Column headers -->
          <Grid Grid.Row="0"
                Style="{StaticResource ColumnHeaderGridStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="32" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="0.7*" />
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0"
                      x:Name="CheckAllBox"
                      IsChecked="True"
                      MinWidth="0"
                      Padding="0"
                      Click="CheckAll_Click"
                      ToolTipService.ToolTip="Check / uncheck all" />
            <Button Grid.Column="1"
                    Content="File Name"
                    Style="{StaticResource SortableColumnHeaderButtonStyle}"
                    local:FileTableBehavior.SortProperty="FileName" />
            <Button Grid.Column="2"
                    Content="Folder"
                    Style="{StaticResource SortableColumnHeaderButtonStyle}"
                    local:FileTableBehavior.SortProperty="FolderDisplay" />
            <Button Grid.Column="3"
                    Content="Duration"
                    HorizontalContentAlignment="Center"
                    Style="{StaticResource SortableColumnHeaderButtonStyle}"
                    local:FileTableBehavior.SortProperty="DurationDisplay" />
            <Button Grid.Column="4"
                    Content="Resolution"
                    HorizontalContentAlignment="Center"
                    Style="{StaticResource SortableColumnHeaderButtonStyle}"
                    local:FileTableBehavior.SortProperty="ResolutionDisplay" />
            <Button Grid.Column="5"
                    Content="Size"
                    HorizontalContentAlignment="Center"
                    Style="{StaticResource SortableColumnHeaderButtonStyle}"
                    local:FileTableBehavior.SortProperty="SizeDisplay" />
            <Button Grid.Column="6"
                    Content="Status"
                    Style="{StaticResource SortableColumnHeaderButtonStyle}"
                    local:FileTableBehavior.SortProperty="Status" />
          </Grid>

          <!-- Files ListView -->
          <ListView
            x:Name="FilesListView"
            Grid.Row="1"
            SelectionMode="Single"
            Style="{StaticResource FileListViewStyle}"
            SelectionChanged="FilesListView_SelectionChanged">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="local:SfdFileEntry">
                <Grid Style="{StaticResource ListItemRowGridStyle}"
                      local:FileTableBehavior.IsRow="True">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="0.7*" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="90" />
                  </Grid.ColumnDefinitions>
                  <CheckBox
                    Grid.Column="0"
                    MinWidth="0"
                    Padding="0"
                    VerticalAlignment="Center"
                    IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                  <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{x:Bind FileName}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind FilePath}" />
                  <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind FolderDisplay}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind FolderDisplay}" />
                  <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Text="{x:Bind DurationDisplay, Mode=OneWay}" />
                  <TextBlock
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Text="{x:Bind ResolutionDisplay, Mode=OneWay}" />
                  <TextBlock
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Text="{x:Bind SizeDisplay}" />
                  <TextBlock
                    Grid.Column="6"
                    VerticalAlignment="Center"
                    Foreground="{x:Bind StatusColor, Mode=OneWay}"
                    Text="{x:Bind StatusDisplay, Mode=OneWay}" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>

      <!-- Empty state -->
      <Border
        x:Name="EmptyStatePanel"
        Grid.Column="0"
        VerticalAlignment="Stretch"
        Style="{StaticResource CardBorderStyle}">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
          <FontIcon FontSize="64"
                    Glyph="&#xE714;"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock
            Text="No directory selected"
            FontSize="18"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextAlignment="Center" />
          <TextBlock
            Text="Select a folder of video files or a game archive (WAD/PRE/PKR/PAK/...)"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            TextAlignment="Center"
            TextWrapping="Wrap"
            MaxWidth="440" />
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      Spacing="8">
            <Button
              Content="Browse folder..."
              Click="InputBrowse_Click"
              Style="{StaticResource AccentButtonStyle}" />
            <Button
              Content="Select archive..."
              Click="SelectArchive_Click" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Video preview panel -->
      <Border
        x:Name="PreviewPanel"
        Grid.Column="2"
        VerticalAlignment="Stretch"
        Style="{StaticResource CardBorderStyle}">
        <Grid Margin="4" RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Zoom bar -->
          <ComboBox
            x:Name="VideoZoomCombo"
            Grid.Row="0"
            HorizontalAlignment="Left"
            MinWidth="120"
            SelectedIndex="0"
            SelectionChanged="VideoZoomCombo_SelectionChanged">
            <ComboBoxItem Content="Zoom to fit" />
            <ComboBoxItem Content="100%" />
          </ComboBox>

          <!-- Video display area -->
          <Border Grid.Row="1"
                  Style="{StaticResource DarkCardBorderStyle}"
                  Padding="0"
                  MinHeight="200"
                  HorizontalAlignment="Stretch">
            <Grid>
              <ScrollViewer
                x:Name="VideoScroller"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollMode="Disabled"
                ZoomMode="Disabled">
                <Grid x:Name="VideoHost"
                      Background="Transparent"
                      PointerPressed="VideoHost_PointerPressed"
                      PointerMoved="VideoHost_PointerMoved"
                      PointerReleased="VideoHost_PointerReleased"
                      PointerCanceled="VideoHost_PointerReleased"
                      PointerCaptureLost="VideoHost_PointerReleased">
                  <MediaPlayerElement x:Name="VideoPlayer"
                                      AreTransportControlsEnabled="False"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch" />
                </Grid>
              </ScrollViewer>
              <StackPanel x:Name="VideoPlaceholderPanel"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Spacing="8">
                <FontIcon FontSize="48"
                          Glyph="&#xE714;"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Click on an entry to preview."
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           TextAlignment="Center" />
              </StackPanel>
              <ProgressRing x:Name="PreviewLoading"
                            IsActive="False"
                            Width="32" Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
            </Grid>
          </Border>

          <!-- File name -->
          <TextBlock x:Name="PreviewFileNameText"
                     Grid.Row="2"
                     HorizontalAlignment="Center"
                     FontSize="12"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"
                     MaxWidth="340" />

          <!-- Info text -->
          <TextBlock x:Name="PreviewInfoText"
                     Grid.Row="3"
                     HorizontalAlignment="Center"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     FontSize="11"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     MaxWidth="340" />

          <!-- Playback position slider -->
          <Slider x:Name="PlaybackSlider"
                  Grid.Row="4"
                  Minimum="0"
                  Maximum="100"
                  Value="0"
                  StepFrequency="0.1"
                  HorizontalAlignment="Stretch"
                  Margin="0,4,0,0"
                  ThumbToolTipValueConverter="{StaticResource PlaybackTooltipConverter}"
                  ValueChanged="PlaybackSlider_ValueChanged" />

          <!-- Time display -->
          <Grid Grid.Row="5" Margin="0,-8,0,0">
            <TextBlock x:Name="CurrentTimeText"
                       Text="00:00"
                       FontSize="11"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       HorizontalAlignment="Left" />
            <TextBlock x:Name="TotalTimeText"
                       Text="00:00"
                       FontSize="11"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       HorizontalAlignment="Right" />
          </Grid>

          <!-- Transport controls -->
          <StackPanel Grid.Row="6"
                      Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      Spacing="8">
            <Button x:Name="StopButton"
                    Click="StopButton_Click"
                    Padding="8"
                    MinWidth="0"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Stop">
              <FontIcon FontSize="14" Glyph="&#xE71A;" />
            </Button>
            <Button x:Name="PlayPauseButton"
                    Click="PlayPauseButton_Click"
                    Padding="8"
                    MinWidth="0"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Play">
              <FontIcon x:Name="PlayPauseIcon" FontSize="16" Glyph="&#xE768;" />
            </Button>
            <FontIcon FontSize="14"
                      Glyph="&#xE767;"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <!--  No initial Value: it is applied from UserSettings in the
                  constructor, and a XAML Value would fire ValueChanged during
                  InitializeComponent before that.  -->
            <Slider x:Name="VolumeSlider"
                    Width="100"
                    Minimum="0"
                    Maximum="100"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Volume"
                    ValueChanged="VolumeSlider_ValueChanged" />
          </StackPanel>

          <!-- Error display -->
          <TextBlock x:Name="PreviewErrorText"
                     Grid.Row="7"
                     HorizontalAlignment="Center"
                     Foreground="Red"
                     FontSize="11"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     MaxWidth="340"
                     Visibility="Collapsed" />
        </Grid>
      </Border>
    </Grid>

    <!-- Progress Bar -->
    <ProgressBar
      x:Name="ConversionProgress"
      Grid.Row="2"
      Maximum="100"
      Style="{StaticResource TabProgressBarStyle}" />

    <!-- I/O Section -->
    <Grid Grid.Row="3"
          Style="{StaticResource IoSectionGridStyle}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0"
                 Text="Input:"
                 Style="{StaticResource IoLabelStyle}" />
      <TextBox x:Name="InputPathText"
               Grid.Row="0" Grid.Column="1"
               IsReadOnly="True"
               Style="{StaticResource IoTextBoxStyle}" />
      <StackPanel Grid.Row="0" Grid.Column="2"
                  Style="{StaticResource IoButtonsPanelStyle}">
        <Button Content="Browse folder..."
                MinWidth="120"
                Click="InputBrowse_Click" />
        <Button Content="Select archive..."
                MinWidth="120"
                Click="SelectArchive_Click" />
      </StackPanel>

      <TextBlock Grid.Row="1" Grid.Column="0"
                 Text="Output:"
                 Style="{StaticResource IoLabelStyle}" />
      <TextBox x:Name="OutputPathText"
               Grid.Row="1" Grid.Column="1"
               IsReadOnly="True"
               Style="{StaticResource IoTextBoxStyle}" />
      <StackPanel Grid.Row="1" Grid.Column="2"
                  Style="{StaticResource IoButtonsPanelStyle}">
        <Button
          Content="Browse folder..."
          MinWidth="120"
          Click="OutputBrowse_Click" />
        <!-- Cancel occupies Convert's slot while a conversion runs (the two
             are toggled as a pair, only one visible at a time). -->
        <Button
          x:Name="CancelButton"
          Content="Cancel"
          MinWidth="120"
          Click="CancelButton_Click"
          Visibility="Collapsed" />
        <Button
          x:Name="ConvertButton"
          Content="Convert"
          Click="ConvertButton_Click"
          IsEnabled="False"
          MinWidth="120"
          Style="{StaticResource AccentButtonStyle}" />
      </StackPanel>
    </Grid>

    <!-- ffmpeg warning bar -->
    <InfoBar
      x:Name="FfmpegWarning"
      Grid.Row="0"
      Title="ffmpeg not found"
      Message="Install ffmpeg (ffmpeg.org) and ensure it's on your PATH to enable video conversion."
      Severity="Warning"
      IsOpen="False"
      IsClosable="False"
      VerticalAlignment="Top"
      HorizontalAlignment="Stretch" />
  </Grid>
</UserControl>
