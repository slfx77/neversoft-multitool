<?xml version="1.0" encoding="utf-8"?>

<UserControl
  x:Class="NeversoftMultitool.LevelsTab"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:NeversoftMultitool"
  xmlns:controls="using:CommunityToolkit.WinUI.Controls">

  <Grid Padding="16"
        VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header row -->
    <Grid Grid.Row="0"
          Margin="0,0,0,8">
      <StackPanel Style="{StaticResource TabHeaderStackPanelStyle}">
        <TextBlock
          Text="Levels"
          Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBlock
          Text="Browse world-scale content: fly or walk a level in 3D, or view it as it was authored, and export either to PNG"
          Style="{StaticResource TabSubtitleStyle}" />
      </StackPanel>
    </Grid>

    <!-- Main content: level list | view surface | tabbed panel -->
    <Grid x:Name="ContentColumnsGrid"
          Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="FileListColumn" Width="560" MinWidth="320" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition x:Name="ViewerColumn" Width="*" MinWidth="300" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition x:Name="SidePanelColumn" Width="380" MinWidth="280" />
      </Grid.ColumnDefinitions>

      <controls:GridSplitter
        x:Name="LeftSplitter"
        Grid.Column="1"
        Width="8"
        ResizeBehavior="PreviousAndNext"
        ResizeDirection="Columns" />
      <controls:GridSplitter
        x:Name="RightSplitter"
        Grid.Column="3"
        Width="8"
        ResizeBehavior="PreviousAndNext"
        ResizeDirection="Columns" />

      <!-- Left: level list -->
      <Grid Grid.Column="0">
        <Grid x:Name="LeftPanelContent">

          <Border
            x:Name="FileListCard"
            VerticalAlignment="Stretch"
            Style="{StaticResource CardBorderStyle}"
            Visibility="Collapsed">
            <Grid x:Name="FilesTableHost"
                  VerticalAlignment="Stretch"
                  local:FileTableBehavior.IsEnabled="True">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0"
                          Orientation="Horizontal"
                          Padding="0,0,8,4"
                          Spacing="8">
                <Button Content="Select all"
                        Click="FilesSelectAll_Click" />
                <Button Content="Select none"
                        Click="FilesSelectNone_Click" />
                <TextBox x:Name="FilesFilterBox"
                         MinWidth="180"
                         VerticalAlignment="Center"
                         PlaceholderText="Filter level names"
                         TextChanged="FilesFilterBox_TextChanged"
                         AutomationProperties.Name="Filter level names" />
              </StackPanel>

              <Grid Grid.Row="1"
                    Style="{StaticResource ColumnHeaderGridStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="32" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="" />
                <Button Grid.Column="1"
                        Content="Level"
                        Margin="8,0,0,0"
                        Style="{StaticResource SortableColumnHeaderButtonStyle}"
                        local:FileTableBehavior.SortProperty="RelativePath" />
                <Button Grid.Column="2"
                        Content="Format"
                        HorizontalContentAlignment="Center"
                        Style="{StaticResource SortableColumnHeaderButtonStyle}"
                        local:FileTableBehavior.SortProperty="Format" />
                <Button Grid.Column="3"
                        Content="Meshes"
                        HorizontalContentAlignment="Center"
                        Style="{StaticResource SortableColumnHeaderButtonStyle}"
                        local:FileTableBehavior.SortProperty="MeshCount" />
                <Button Grid.Column="4"
                        Content="Triangles"
                        HorizontalContentAlignment="Center"
                        Style="{StaticResource SortableColumnHeaderButtonStyle}"
                        local:FileTableBehavior.SortProperty="TriangleCount" />
                <Button Grid.Column="5"
                        Content="Status"
                        Style="{StaticResource SortableColumnHeaderButtonStyle}"
                        local:FileTableBehavior.SortProperty="Status" />
              </Grid>

              <ListView
                x:Name="FilesListView"
                Grid.Row="2"
                SelectionMode="Single"
                SelectionChanged="FilesListView_SelectionChanged"
                Style="{StaticResource FileListViewStyle}">
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="local:MeshFileEntry">
                    <Grid Style="{StaticResource ListItemRowGridStyle}"
                          local:FileTableBehavior.IsRow="True">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="100" />
                      </Grid.ColumnDefinitions>
                      <CheckBox
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Margin="6,0,0,0"
                        MinWidth="24"
                        IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                        Click="FileCheckbox_Click" />
                      <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0"
                        Text="{x:Bind RelativePath}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind FilePath}" />
                      <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind FormatDisplay}" />
                      <TextBlock
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Text="{x:Bind MeshesDisplay}" />
                      <TextBlock
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Text="{x:Bind TrianglesDisplay, Mode=OneWay}" />
                      <TextBlock
                        Grid.Column="5"
                        VerticalAlignment="Center"
                        Foreground="{x:Bind StatusColor, Mode=OneWay}"
                        Text="{x:Bind StatusDisplay, Mode=OneWay}" />
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>
          </Border>

          <!-- Empty state -->
          <Border
            x:Name="EmptyStatePanel"
            VerticalAlignment="Stretch"
            Style="{StaticResource CardBorderStyle}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16">
              <FontIcon FontSize="64"
                        Glyph="&#xE809;"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock
                x:Name="EmptyStateTitle"
                Text="No levels loaded"
                FontSize="18"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center" />
              <TextBlock
                x:Name="EmptyStateDetail"
                Text="Select a folder (scanned recursively) or a game archive. Level geometry, object banks and their companions are resolved automatically; characters and props open in Meshes &amp; Characters."
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="440" />
              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Center"
                          Spacing="8">
                <Button
                  Content="Browse folder..."
                  Click="InputBrowse_Click"
                  Style="{StaticResource AccentButtonStyle}" />
                <Button
                  Content="Select archive..."
                  Click="SelectArchive_Click" />
                <Button
                  x:Name="GoToModelsButton"
                  Content="Open Meshes &amp; Characters"
                  Visibility="Collapsed"
                  Click="GoToModels_Click" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Collapsed strip -->
        <Border
          x:Name="LeftCollapsedStrip"
          Style="{StaticResource CardBorderStyle}"
          Padding="2"
          Visibility="Collapsed">
          <Button
            x:Name="ExpandLeftPanelButton"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Top"
            Padding="4,10"
            MinWidth="0"
            MinHeight="0"
            Background="Transparent"
            BorderThickness="0"
            ToolTipService.ToolTip="Expand the level list"
            AutomationProperties.Name="Expand level list">
            <FontIcon Glyph="&#xE76C;" FontSize="12" />
          </Button>
        </Border>
      </Grid>

      <!-- Centre: the view surface -->
      <Grid Grid.Column="2">
        <local:ModelViewerControl x:Name="ModelViewer" />
        <Button
          x:Name="CollapseLeftPanelButton"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          Margin="4"
          Padding="4,10"
          MinWidth="0"
          MinHeight="0"
          Background="Transparent"
          BorderThickness="0"
          ToolTipService.ToolTip="Collapse the level list"
          AutomationProperties.Name="Collapse level list">
          <FontIcon Glyph="&#xE76B;" FontSize="12" />
        </Button>
        <Button
          x:Name="CollapseRightPanelButton"
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          Margin="4"
          Padding="4,10"
          MinWidth="0"
          MinHeight="0"
          Background="Transparent"
          BorderThickness="0"
          ToolTipService.ToolTip="Collapse the side panel"
          AutomationProperties.Name="Collapse side panel">
          <FontIcon Glyph="&#xE76C;" FontSize="12" />
        </Button>
      </Grid>

      <!-- Right: Display / Export -->
      <Grid Grid.Column="4">
        <Border x:Name="RightPanelContent"
                VerticalAlignment="Stretch"
                Style="{StaticResource CardBorderStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <SelectorBar x:Name="PanelSelector"
                         Grid.Row="0"
                         Margin="0,0,0,8"
                         SelectionChanged="PanelSelector_SelectionChanged">
              <SelectorBarItem x:Name="DisplayPanelItem" Text="Display" />
              <SelectorBarItem x:Name="ExportPanelItem" Text="Export" />
            </SelectorBar>

            <!-- Display pane -->
            <ScrollViewer x:Name="DisplayPane"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
              <StackPanel Spacing="12" Padding="0,0,8,8">
                <CheckBox
                  x:Name="DisplayIncludeLevelObjectsCheckbox"
                  Content="Include level objects"
                  MinWidth="0"
                  IsChecked="True"
                  Visibility="Collapsed"
                  ToolTipService.ToolTip="Include authored objects from the level's companion object file"
                  Click="DisplayIncludeLevelObjectsCheckbox_Click" />
                <Grid x:Name="WorldzoneViewportSettingsSection"
                      ColumnSpacing="8"
                      RowSpacing="8"
                      Visibility="Collapsed">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0"
                             Text="Lighting"
                             VerticalAlignment="Center"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <ComboBox x:Name="WorldzoneTimeCombo"
                            Grid.Row="0" Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="0"
                            SelectionChanged="WorldzoneTimeCombo_SelectionChanged">
                    <ComboBoxItem Content="Day" Tag="day" />
                    <ComboBoxItem Content="Night" Tag="night" />
                  </ComboBox>
                </Grid>

                <TextBlock Text="Visibility"
                           Margin="0,8,0,0"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="DisplayEmptyText"
                           Text="Select a level to see its display options."
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ItemsControl x:Name="VisibilityGroupsList" />
              </StackPanel>
            </ScrollViewer>

            <!-- Export pane -->
            <ScrollViewer x:Name="ExportPane"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="12" Padding="0,0,8,8">
                <TextBlock Text="Convert"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <CheckBox
                  x:Name="ExportIncludeLevelObjectsCheckbox"
                  Content="Include level objects"
                  MinWidth="0"
                  IsChecked="True"
                  Visibility="Collapsed"
                  ToolTipService.ToolTip="Include authored objects from companion object files in exported output" />
                <StackPanel x:Name="WorldzoneExportSettingsSection"
                            Spacing="8"
                            Visibility="Collapsed">
                  <TextBlock Text="Worldzone"
                             FontWeight="SemiBold"
                             Margin="0,4,0,0" />
                  <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Lighting"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ToggleSwitch x:Name="ExportWorldzoneNightToggle"
                                  Grid.Row="0" Grid.Column="1"
                                  OffContent="Day"
                                  OnContent="Night"
                                  IsOn="False" />
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Scale"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBox x:Name="WorldzoneScaleText"
                             Grid.Row="1" Grid.Column="1"
                             Text="1" />
                  </Grid>
                </StackPanel>
                <CheckBox x:Name="ExportGlbCheckbox"
                          Content="glTF (.glb)"
                          IsChecked="True"
                          Click="ExportFormatCheckbox_Changed" />
                <Grid>
                  <CheckBox x:Name="ExportBlendCheckbox"
                            Content="Blender (.blend)"
                            Click="ExportFormatCheckbox_Changed" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="ConvertButton"
                          Content="Convert"
                          IsEnabled="False"
                          Click="Convert_Click"
                          Style="{StaticResource AccentButtonStyle}" />
                  <Button x:Name="CancelButton"
                          Content="Cancel"
                          IsEnabled="False"
                          Click="Cancel_Click" />
                </StackPanel>

                <TextBlock Text="Render"
                           Margin="0,8,0,0"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                  Text="Headless rasterizer - not the interactive viewport camera."
                  FontSize="11"
                  TextWrapping="Wrap"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <NumberBox x:Name="RenderSizeBox"
                             Grid.Column="0"
                             Header="Size (px)"
                             Minimum="16"
                             Maximum="4096"
                             Value="1024"
                             SmallChange="64"
                             LargeChange="256"
                             SpinButtonPlacementMode="Compact" />
                  <NumberBox x:Name="RenderAzimuthBox"
                             Grid.Column="1"
                             Header="Azimuth"
                             Minimum="-360"
                             Maximum="360"
                             Value="-90"
                             SmallChange="15"
                             LargeChange="45"
                             SpinButtonPlacementMode="Compact" />
                </Grid>
                <NumberBox x:Name="RenderElevationBox"
                           Header="Elevation"
                           Minimum="-90"
                           Maximum="90"
                           Value="30"
                           SmallChange="5"
                           LargeChange="15"
                           SpinButtonPlacementMode="Compact" />
                <Button x:Name="RenderPngButton"
                        Content="Export as PNG..."
                        IsEnabled="False"
                        Click="RenderPng_Click" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>

        <Border
          x:Name="RightCollapsedStrip"
          Style="{StaticResource CardBorderStyle}"
          Padding="2"
          Visibility="Collapsed">
          <Button
            x:Name="ExpandRightPanelButton"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Top"
            Padding="4,10"
            MinWidth="0"
            MinHeight="0"
            Background="Transparent"
            BorderThickness="0"
            ToolTipService.ToolTip="Expand the side panel"
            AutomationProperties.Name="Expand side panel">
            <FontIcon Glyph="&#xE76B;" FontSize="12" />
          </Button>
        </Border>
      </Grid>
    </Grid>

    <ProgressBar
      x:Name="ConversionProgress"
      Grid.Row="2"
      Maximum="100"
      Style="{StaticResource TabProgressBarStyle}" />

    <!-- I/O Section -->
    <Grid Grid.Row="3"
          Style="{StaticResource IoSectionGridStyle}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0"
                 Text="Input:"
                 Style="{StaticResource IoLabelStyle}" />
      <TextBox x:Name="InputPathText"
               Grid.Row="0" Grid.Column="1"
               IsReadOnly="True"
               Style="{StaticResource IoTextBoxStyle}" />
      <StackPanel Grid.Row="0" Grid.Column="2"
                  Style="{StaticResource IoButtonsPanelStyle}">
        <Button Content="Browse folder..."
                MinWidth="120"
                Click="InputBrowse_Click" />
        <Button Content="Select archive..."
                MinWidth="120"
                Click="SelectArchive_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
