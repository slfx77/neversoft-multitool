<?xml version="1.0" encoding="utf-8"?>

<UserControl
  x:Class="NeversoftMultitool.ImagePreviewControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Zoom bar -->
    <Grid Grid.Row="0">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <ComboBox
          x:Name="ZoomModeCombo"
          MinWidth="120"
          SelectedIndex="0"
          SelectionChanged="ZoomModeCombo_SelectionChanged">
          <ComboBoxItem Content="Zoom to fit" />
          <ComboBoxItem Content="100%" />
        </ComboBox>
        <CheckBox
          x:Name="FilteringCheckbox"
          Content="Filtering"
          MinWidth="0"
          VerticalAlignment="Center"
          IsChecked="True"
          Checked="FilteringCheckbox_Changed"
          Unchecked="FilteringCheckbox_Changed"
          ToolTipService.ToolTip="Off: nearest-neighbor at the largest integer scale that fits" />
      </StackPanel>
      <TextBlock
        x:Name="DimensionsText"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>

    <!-- Image area -->
    <Border Grid.Row="1"
            Style="{StaticResource DarkCardBorderStyle}"
            Padding="4">
      <Grid>
        <!-- A neutral checkerboard makes retained alpha immediately visible.
             It sits behind the image rather than being baked into exports. -->
        <Image
          x:Name="TransparencyBackground"
          Stretch="Fill"
          Visibility="Collapsed"
          IsHitTestVisible="False"
          SizeChanged="TransparencyBackground_SizeChanged" />
        <ScrollViewer
          x:Name="Scroller"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Disabled"
          HorizontalScrollMode="Disabled"
          VerticalScrollMode="Disabled"
          ZoomMode="Disabled"
          SizeChanged="Scroller_SizeChanged">
          <Image
            x:Name="PreviewImage"
            Stretch="Uniform"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            PointerPressed="PreviewImage_PointerPressed"
            PointerMoved="PreviewImage_PointerMoved"
            PointerReleased="PreviewImage_PointerReleased"
            PointerCanceled="PreviewImage_PointerReleased"
            PointerCaptureLost="PreviewImage_PointerReleased" />
        </ScrollViewer>

        <TextBlock
          x:Name="PlaceholderText"
          Text="Click on an entry to preview."
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          TextWrapping="Wrap"
          TextAlignment="Center"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <ProgressRing
          x:Name="LoadingRing"
          Width="32"
          Height="32"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          IsActive="False"
          Visibility="Collapsed" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
