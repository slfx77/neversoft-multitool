<?xml version="1.0" encoding="utf-8"?>

<UserControl
  x:Class="NeversoftMultitool.ModelViewerControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:CommunityToolkit.WinUI.Controls">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Camera toolbar: projection presets + named views + 90° azimuth snap.
         A WrapPanel so narrow viewer columns wrap the controls to a second
         row instead of clipping them at the card edge.
         The projection ComboBox gets its initial selection in the constructor
         (a XAML SelectedIndex would fire SelectionChanged mid-InitializeComponent). -->
    <controls:WrapPanel
      x:Name="CameraToolbar"
      Grid.Row="0"
      Padding="12,8,12,4"
      HorizontalSpacing="8"
      VerticalSpacing="4">

      <ComboBox
        x:Name="ProjectionCombo"
        MinWidth="150"
        SelectionChanged="ProjectionCombo_SelectionChanged">
        <ComboBoxItem Content="Perspective" />
        <ComboBoxItem Content="Orthographic (top)" />
        <ComboBoxItem Content="Isometric" />
        <ComboBoxItem Content="Trimetric" />
      </ComboBox>

      <DropDownButton Content="View">
        <DropDownButton.Flyout>
          <MenuFlyout>
            <MenuFlyoutItem Text="Front" Tag="Front" Click="ViewPreset_Click" />
            <MenuFlyoutItem Text="Back" Tag="Back" Click="ViewPreset_Click" />
            <MenuFlyoutItem Text="Left" Tag="Left" Click="ViewPreset_Click" />
            <MenuFlyoutItem Text="Right" Tag="Right" Click="ViewPreset_Click" />
            <MenuFlyoutItem Text="Top" Tag="Top" Click="ViewPreset_Click" />
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>

      <!-- Camera control mode. Orbit is the classic model orbit; Fly/Walk are
           first-person (WASD + mouse-look, perspective-only). The active
           toggle is set in the constructor / from the page's controlMode
           messages, never in XAML (a XAML IsChecked would fire handlers
           mid-InitializeComponent). -->
      <StackPanel
        Orientation="Horizontal"
        Spacing="4"
        ToolTipService.ToolTip="F toggles Fly/Walk; O toggles Orbit; Space jumps in Walk; P copies this view to the clipboard for glb-render">
        <ToggleButton
          x:Name="OrbitModeButton"
          Height="32"
          Content="Orbit"
          Tag="orbit"
          Click="ModeButton_Click" />
        <ToggleButton
          x:Name="FlyModeButton"
          Height="32"
          Content="Fly"
          Tag="fly"
          Click="ModeButton_Click" />
        <ToggleButton
          x:Name="WalkModeButton"
          Height="32"
          Content="Walk"
          Tag="walk"
          Click="ModeButton_Click" />
      </StackPanel>

      <!-- Azimuth snap pair wraps as one unit -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button
          Width="36"
          Height="32"
          Padding="0"
          ToolTipService.ToolTip="Rotate 90° left"
          Click="StepAzimuthLeft_Click">
          <FontIcon
            FontFamily="Segoe UI Symbol"
            FontSize="17"
            Glyph="&#x21B6;" />
        </Button>
        <Button
          Width="36"
          Height="32"
          Padding="0"
          ToolTipService.ToolTip="Rotate 90° right"
          Click="StepAzimuthRight_Click">
          <FontIcon
            FontFamily="Segoe UI Symbol"
            FontSize="17"
            Glyph="&#x21B7;" />
        </Button>
      </StackPanel>
    </controls:WrapPanel>

    <!-- WebView2 3D viewer -->
    <WebView2
      x:Name="ModelWebView"
      Grid.Row="1" />

    <!-- Placeholder before the WebView2 is initialized -->
    <TextBlock
      x:Name="PlaceholderText"
      Grid.Row="1"
      Text="Click on an entry to preview."
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      TextWrapping="Wrap"
      TextAlignment="Center"
      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

    <!-- Loading overlay. The WebView's own HTML status text is centered in
         this same row, so the ring is nudged down to sit below it. -->
    <ProgressRing
      x:Name="LoadingRing"
      Grid.Row="1"
      Margin="0,72,0,0"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      IsActive="False"
      Visibility="Collapsed" />

    <!-- Animation transport (visible only when the GLB has animations) -->
    <Grid x:Name="TransportPanel"
          Grid.Row="2"
          Padding="12,8,12,0"
          ColumnSpacing="8"
          Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button
        x:Name="PlayPauseButton"
        Grid.Column="0"
        Width="36"
        Height="36"
        Padding="0"
        Click="PlayPauseButton_Click"
        Style="{StaticResource AccentButtonStyle}">
        <FontIcon x:Name="PlayPauseIcon" FontSize="14" Glyph="&#xE769;" />
      </Button>
      <TextBlock
        x:Name="CurrentTimeText"
        Grid.Column="1"
        VerticalAlignment="Center"
        FontSize="12"
        Text="0.00" />
      <Slider
        x:Name="PlaybackSlider"
        Grid.Column="2"
        Minimum="0"
        Maximum="1"
        StepFrequency="0.01"
        VerticalAlignment="Center"
        ValueChanged="PlaybackSlider_ValueChanged" />
      <TextBlock
        x:Name="TotalTimeText"
        Grid.Column="3"
        VerticalAlignment="Center"
        FontSize="12"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        Text="0.00 s" />
    </Grid>

    <!-- Model info + error -->
    <StackPanel Grid.Row="3"
                Padding="12,8"
                Spacing="2">
      <TextBlock
        x:Name="InfoText"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        FontSize="12"
        TextWrapping="Wrap" />
      <TextBlock
        x:Name="ErrorText"
        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
        FontSize="12"
        TextWrapping="Wrap"
        Visibility="Collapsed" />
    </StackPanel>
  </Grid>
</UserControl>
