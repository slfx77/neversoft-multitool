<?xml version="1.0" encoding="utf-8"?>

<UserControl
  x:Class="NeversoftMultitool.ModelViewerControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- WebView2 3D viewer -->
    <WebView2
      x:Name="ModelWebView"
      Grid.Row="0" />

    <!-- Placeholder before the WebView2 is initialized -->
    <TextBlock
      x:Name="PlaceholderText"
      Grid.Row="0"
      Text="Click on an entry to preview."
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      TextWrapping="Wrap"
      TextAlignment="Center"
      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

    <!-- Loading overlay -->
    <ProgressRing
      x:Name="LoadingRing"
      Grid.Row="0"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      IsActive="False"
      Visibility="Collapsed" />

    <!-- Animation transport (visible only when the GLB has animations) -->
    <Grid x:Name="TransportPanel"
          Grid.Row="1"
          Padding="12,8,12,0"
          ColumnSpacing="8"
          Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button
        x:Name="PlayPauseButton"
        Grid.Column="0"
        Width="36"
        Height="36"
        Padding="0"
        Click="PlayPauseButton_Click"
        Style="{StaticResource AccentButtonStyle}">
        <FontIcon x:Name="PlayPauseIcon" FontSize="14" Glyph="&#xE769;" />
      </Button>
      <TextBlock
        x:Name="CurrentTimeText"
        Grid.Column="1"
        VerticalAlignment="Center"
        FontSize="12"
        Text="0.00" />
      <Slider
        x:Name="PlaybackSlider"
        Grid.Column="2"
        Minimum="0"
        Maximum="1"
        StepFrequency="0.01"
        VerticalAlignment="Center"
        ValueChanged="PlaybackSlider_ValueChanged" />
      <TextBlock
        x:Name="TotalTimeText"
        Grid.Column="3"
        VerticalAlignment="Center"
        FontSize="12"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        Text="0.00 s" />
    </Grid>

    <!-- Model info + error -->
    <StackPanel Grid.Row="2"
                Padding="12,8"
                Spacing="2">
      <TextBlock
        x:Name="InfoText"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        FontSize="12"
        TextWrapping="Wrap" />
      <TextBlock
        x:Name="ErrorText"
        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
        FontSize="12"
        TextWrapping="Wrap"
        Visibility="Collapsed" />
    </StackPanel>
  </Grid>
</UserControl>
