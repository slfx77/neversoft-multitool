<?xml version="1.0" encoding="utf-8"?>

<Window
  x:Class="NeversoftMultitool.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:tabs="using:NeversoftMultitool"
  Title="Neversoft Multitool">

  <Grid>
    <!--  Title bar with app name (behind NavigationView so expanded pane covers it)  -->
    <Grid
      x:Name="AppTitleBar"
      Height="32"
      Margin="48,0,0,0"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Top"
      Background="Transparent">
      <StackPanel
        Orientation="Horizontal"
        VerticalAlignment="Center">
        <Image
          Width="16"
          Height="16"
          Margin="8,1,8,0"
          VerticalAlignment="Center"
          Source="ms-appx:///Assets/AppIcon.png" />
        <TextBlock
          Text="Neversoft Multitool"
          VerticalAlignment="Center"
          FontSize="12" />
      </StackPanel>
    </Grid>

    <!--  Navigation View with hamburger menu - fills entire window  -->
    <NavigationView
      x:Name="NavView"
      Background="Transparent"
      IsBackButtonVisible="Collapsed"
      IsPaneToggleButtonVisible="True"
      IsSettingsVisible="False"
      IsTitleBarAutoPaddingEnabled="True"
      OpenPaneLength="200"
      PaneDisplayMode="LeftCompact"
      ItemInvoked="NavView_ItemInvoked"
      SelectionChanged="NavView_SelectionChanged">

      <NavigationView.MenuItems>
        <NavigationViewItemHeader Content="Images" />

        <!--  Texture Extraction  -->
        <NavigationViewItem
          Content="Textures"
          IsSelected="True"
          Tag="Textures">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xEB9F;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <!--  Bitmap Conversion (RLE/BMR/ZLB/BMP/TGA)  -->
        <NavigationViewItem
          Content="Bitmap Converter"
          Tag="RleBitmaps">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8B9;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <NavigationViewItemSeparator />

        <NavigationViewItemHeader Content="Archives" />

        <!--  Archive Extractor  -->
        <NavigationViewItem
          Content="Archive Extractor"
          Tag="Archives">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE7B8;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <!--  Game Unpacker  -->
        <NavigationViewItem
          Content="Game Unpacker"
          Tag="Unpack">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE74C;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <NavigationViewItemSeparator />

        <NavigationViewItemHeader Content="Audio" />

        <!--  Audio Converter  -->
        <NavigationViewItem
          Content="Audio Converter"
          Tag="AudioConverter">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8D6;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <NavigationViewItemSeparator />

        <NavigationViewItemHeader Content="Video" />

        <!--  Video Converter  -->
        <NavigationViewItem
          Content="Video Converter"
          Tag="VideoConverter">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE714;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <NavigationViewItemSeparator />

        <NavigationViewItemHeader Content="3D Models" />

        <!--  Meshes & Characters (merged mesh conversion + character preview)  -->
        <NavigationViewItem
          Content="Meshes &amp; Characters"
          Tag="MeshConverter">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xF158;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <NavigationViewItemSeparator />

        <NavigationViewItemHeader Content="Scripts" />

        <!--  Script Decompiler  -->
        <NavigationViewItem
          Content="Script Decompiler"
          Tag="ScriptDecompiler">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE943;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <NavigationViewItemSeparator />

        <NavigationViewItemHeader Content="Tools" />

        <!--  Hash Reviewer  -->
        <NavigationViewItem
          Content="Hash Reviewer"
          Tag="HashReviewer">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE71C;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <NavigationView.FooterMenuItems>
        <!--  Settings drawer toggle (cog, meta-functionality → footer)  -->
        <NavigationViewItem
          x:Name="SettingsNavItem"
          Content="Settings"
          SelectsOnInvoked="False"
          Tag="Settings">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE713;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>

      <!--  Main content area  -->
      <Grid Background="Transparent">
        <Grid.RowDefinitions>
          <RowDefinition Height="32" />
          <!--  Window controls area (title bar)  -->
          <RowDefinition Height="*" />
          <!--  Content  -->
          <RowDefinition Height="Auto" />
          <!--  Status bar  -->
        </Grid.RowDefinitions>

        <!--  Tab content with rounded corners at top-left and bottom-left  -->
        <Border
          Grid.Row="1"
          Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
          CornerRadius="8,0,0,8">
          <Grid VerticalAlignment="Stretch">
            <!--  Settings drawer (overlays the active tab, toggled by the footer cog)  -->
            <Border
              x:Name="SettingsDrawer"
              Style="{StaticResource SettingsDrawerBorderStyle}">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                  <TextBlock Text="Settings"
                             Style="{StaticResource SubtitleTextBlockStyle}" />
                  <StackPanel Spacing="4">
                    <TextBlock Text="Blender"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                      Text=".blend export runs Blender in the background. The path is auto-detected from PATH and standard install folders; pin it here if detection fails."
                      FontSize="12"
                      TextWrapping="Wrap"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock
                      x:Name="BlenderPathStatusText"
                      Margin="0,4,0,4"
                      FontSize="12"
                      TextWrapping="Wrap"
                      IsTextSelectionEnabled="True" />
                    <Button
                      Content="Locate Blender..."
                      HorizontalAlignment="Stretch"
                      ToolTipService.ToolTip="Pick blender.exe (or a Blender install folder)"
                      Click="LocateBlender_Click" />
                    <Button
                      x:Name="BlenderAutoDetectButton"
                      Content="Use auto-detect"
                      HorizontalAlignment="Stretch"
                      IsEnabled="False"
                      ToolTipService.ToolTip="Forget the pinned Blender path and search PATH and standard install folders"
                      Click="BlenderAutoDetect_Click" />
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Border>

            <tabs:TextureTab
              x:Name="TextureTabContent"
              VerticalAlignment="Stretch"
              Visibility="Visible" />
            <tabs:BitmapConverterTab
              x:Name="RleBitmapTabContent"
              VerticalAlignment="Stretch"
              Visibility="Collapsed" />
            <tabs:ArchiveExtractorTab
              x:Name="ArchiveExtractorTabContent"
              VerticalAlignment="Stretch"
              Visibility="Collapsed" />
            <tabs:UnpackTab
              x:Name="UnpackTabContent"
              VerticalAlignment="Stretch"
              Visibility="Collapsed" />
            <tabs:AudioConverterTab
              x:Name="AudioConverterTabContent"
              VerticalAlignment="Stretch"
              Visibility="Collapsed" />
            <tabs:HashReviewerTab
              x:Name="HashReviewerTabContent"
              VerticalAlignment="Stretch"
              Visibility="Collapsed" />
            <tabs:VideoConverterTab
              x:Name="VideoConverterTabContent"
              VerticalAlignment="Stretch"
              Visibility="Collapsed" />
            <tabs:ScriptDecompilerTab
              x:Name="ScriptDecompilerTabContent"
              VerticalAlignment="Stretch"
              Visibility="Collapsed" />
            <tabs:MeshConverterTab
              x:Name="MeshConverterTabContent"
              VerticalAlignment="Stretch"
              Visibility="Collapsed" />
          </Grid>
        </Border>

        <!--  Status bar (same transparent Mica as title bar)  -->
        <Grid
          Grid.Row="2"
          Height="24"
          Padding="15,0,16,0"
          ColumnSpacing="16"
          Background="Transparent">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock
            x:Name="GlobalStatusTextBlock"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextTrimming="CharacterEllipsis"
            Text="" />
          <StackPanel
            x:Name="GlobalProgressPanel"
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <TextBlock
              x:Name="GlobalProgressLabel"
              VerticalAlignment="Center"
              FontSize="12"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ProgressBar
              x:Name="GlobalProgressBar"
              Width="160"
              Maximum="100"
              VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Grid>
    </NavigationView>
  </Grid>
</Window>
